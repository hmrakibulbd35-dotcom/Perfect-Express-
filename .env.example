# ==============================================================================
# BazaarPulse Enterprise Environment Variables Configuration
# ==============================================================================

# Database Connection (PostgreSQL 15+ / 16+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bazaarpulse?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://postgres:password@localhost:5432/bazaarpulse?schema=public"

# App & Server Configuration
PORT=3000
NODE_ENV="development" # or "production"
APP_URL="http://localhost:3000" # Production: https://yourdomain.com

# AI Studio Injection
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT Authentication
JWT_SECRET="super-secure-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# bKash Tokenized Checkout Payment Gateway (v1.2.0-beta / v2)
# Sandbox URL: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production URL: https://tokenized.pay.bka.sh/v1.2.0-beta
# ------------------------------------------------------------------------------
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="your_bkash_sandbox_app_key"
BKASH_APP_SECRET="your_bkash_sandbox_app_secret"
BKASH_USERNAME="your_bkash_sandbox_username"
BKASH_PASSWORD="your_bkash_sandbox_password"
BKASH_CALLBACK_URL="http://localhost:3000/api/v1/payments/bkash/callback"

# ------------------------------------------------------------------------------
# Steadfast Courier Service API
# Production API URL: https://portal.steadfast.com.bd/api/v1
# Obtain credentials from Steadfast Merchant Portal > Settings > API Settings
# ------------------------------------------------------------------------------
STEADFAST_API_URL="https://portal.steadfast.com.bd/api/v1"
STEADFAST_API_KEY="your_steadfast_merchant_api_key"
STEADFAST_SECRET_KEY="your_steadfast_merchant_secret_key"
STEADFAST_WEBHOOK_SECRET="your_custom_webhook_secret_for_signature_verification"
